# ============================================================
# Nuvira production environment. Copy to .env and fill in.
# Never commit the resulting .env file.
# ============================================================

# Nginx Proxy Manager must already be attached to this external network.
PROXY_NETWORK=hermes-network

# --- App ---
APP_NAME=Nuvira
ENV=production
DEBUG=false
FRONTEND_URL=https://nuvira.agentcraft.info
EXTRA_CORS_ORIGINS=
PUBLIC_API_URL=https://api.nuvira.agentcraft.info

# --- Database (internal only; no host port is published) ---
POSTGRES_USER=nuvira
POSTGRES_PASSWORD=change_me_to_a_unique_strong_password
POSTGRES_DB=nuvira
DATABASE_URL=postgresql+psycopg2://nuvira:change_me_to_a_unique_strong_password@db:5432/nuvira

# --- Auth / JWT ---
JWT_SECRET=generate_a_unique_random_string_of_at_least_64_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.nuvira.agentcraft.info/auth/google/callback

# --- Redis / Celery (internal only) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Payments: choose one active provider ---
PAYMENT_PROVIDER=lemonsqueezy

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- AI and embeddings ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENAI_API_KEY=
EMBEDDING_DIM=1536

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=noreply@nuvira.agentcraft.info

# --- First admin (created only when missing) ---
FIRST_ADMIN_EMAIL=admin@nuvira.agentcraft.info
FIRST_ADMIN_PASSWORD=replace_before_first_start

# --- Backup and monitoring ---
COMPOSE_PROJECT_NAME=nuvira
BACKUP_DIR=/root/backups/nuvira
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_RCLONE_REMOTE=
ALERT_EMAIL=
DISK_ALERT_PCT=80
SSL_CHECK_DOMAIN=nuvira.agentcraft.info
SSL_WARN_DAYS=14
RATE_LIMIT_PER_MINUTE=120
