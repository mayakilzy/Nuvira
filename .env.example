# ============================================================
#  FAHEM — environment. Copy to .env and fill in.
# ============================================================

# --- Docker Hub image namespace (YOUR username) ---
DOCKER_NS=aymansaeed
TAG=1.0.0

# --- Host ports (chosen free ports on Hermes server) ---
BACKEND_PORT=8995
FRONTEND_PORT=3008

# --- App ---
APP_NAME=FAHEM
ENV=production
DEBUG=false
FRONTEND_URL=https://suzanna.agentcraft.info
EXTRA_CORS_ORIGINS=
PUBLIC_API_URL=https://api.suzanna.agentcraft.info

# --- Database (internal — do NOT expose this port on the host) ---
POSTGRES_USER=saas
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=saas
DATABASE_URL=postgresql+psycopg2://saas:change_me_strong@db:5432/saas

# --- Auth / JWT ---
JWT_SECRET=generate_a_long_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.suzanna.agentcraft.info/auth/google/callback

# --- Redis / Celery (internal) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Payments: choose ONE active provider (all three are supported) ---
PAYMENT_PROVIDER=lemonsqueezy        # lemonsqueezy | paddle | stripe

# Lemon Squeezy (default — Merchant of Record)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Paddle Billing (Merchant of Record)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox                   # sandbox | production

# Stripe (optional fallback)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- AI layer: OpenRouter (model-agnostic) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@agentcraft.info

# --- First admin (created on first boot) ---
FIRST_ADMIN_EMAIL=admin@agentcraft.info
FIRST_ADMIN_PASSWORD=ChangeMe123!

# --- Backup & Monitoring (Layers 1-3) ---
COMPOSE_PROJECT_NAME=suzanna
BACKUP_DIR=/root/backups/suzanna
BACKUP_KEEP_DAYS=14
# Offsite copy 1 — S3 / Cloudflare R2 (optional; needs awscli on host)
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=                  # e.g. https://<account>.r2.cloudflarestorage.com
# Offsite copy 2 — rclone remote, e.g. customer Google Drive (optional)
BACKUP_RCLONE_REMOTE=                # e.g. gdrive:saas-backups
# Monitoring alerts
ALERT_EMAIL=                         # defaults to FIRST_ADMIN_EMAIL
DISK_ALERT_PCT=80
SSL_CHECK_DOMAIN=suzanna.agentcraft.info
SSL_WARN_DAYS=14
RATE_LIMIT_PER_MINUTE=120

# --- Vector search (pgvector) ---
EMBEDDING_DIM=1536
