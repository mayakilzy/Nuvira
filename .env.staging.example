# Copy to .env.staging and replace every CHANGE_ME value.
# This file is for an isolated local FOUNDATION-01 stack only.
COMPOSE_PROJECT_NAME=nuvira-foundation-staging
STAGING_TAG=staging-01
STAGING_FRONTEND_PORT=3300
STAGING_BACKEND_PORT=8800

APP_NAME=Nuvira Staging
ENV=staging
DEBUG=false
FRONTEND_URL=http://127.0.0.1:3300
EXTRA_CORS_ORIGINS=http://localhost:3300
PUBLIC_API_URL=http://127.0.0.1:8800

POSTGRES_USER=nuvira_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DATABASE_PASSWORD
POSTGRES_DB=nuvira_staging
DATABASE_URL=postgresql+psycopg2://nuvira_staging:CHANGE_ME_STAGING_DATABASE_PASSWORD@db:5432/nuvira_staging
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET=CHANGE_ME_WITH_A_STAGING_ONLY_RANDOM_VALUE_OF_AT_LEAST_64_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
TRUSTED_PROXY_IPS=

GOOGLE_OAUTH_ENABLED=false
PAYMENTS_ENABLED=false
AI_ENABLED=false
EMBEDDING_PROVIDER=openai
EMAIL_ENABLED=false
FIRST_ADMIN_ENABLED=false
UPLOADS_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8800/auth/google/callback
PAYMENT_PROVIDER=lemonsqueezy
OPENROUTER_API_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=staging@example.invalid
FIRST_ADMIN_EMAIL=staging-admin@example.invalid
FIRST_ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN_PASSWORD

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=52428800
MAX_UPLOAD_BYTES_PER_USER=262144000
MAX_UPLOAD_FILES_PER_USER=50
MAX_ARCHIVE_ENTRIES=500
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
